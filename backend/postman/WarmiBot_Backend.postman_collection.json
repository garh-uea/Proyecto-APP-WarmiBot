{
  "info": {
    "name": "WarmiBot Backend Optimizado",
    "description": "Autenticación, caché, N+1, worker y pruebas de seguridad.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://127.0.0.1:800"},
    {"key": "accessToken", "value": ""},
    {"key": "refreshToken", "value": ""},
    {"key": "conversationId", "value": "1"},
    {"key": "jobId", "value": ""}
  ],
  "item": [
    {
      "name": "1. Iniciar sesión",
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "const body = pm.response.json();",
          "pm.collectionVariables.set('accessToken', body.access_token);",
          "pm.collectionVariables.set('refreshToken', body.refresh_token);",
          "pm.test('Login 200', () => pm.response.to.have.status(200));"
        ]}
      }],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/x-www-form-urlencoded"}],
        "body": {"mode": "urlencoded", "urlencoded": [
          {"key": "username", "value": "admin@warmibot.com", "type": "text"},
          {"key": "password", "value": "ChangeMe123!", "type": "text"}
        ]},
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "2. Crear datos de diagnóstico",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{accessToken}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {"mode": "raw", "raw": "{\n  \"conversations\": 10,\n  \"messages_per_conversation\": 5\n}"},
        "url": "{{baseUrl}}/api/v1/diagnostics/seed"
      }
    },
    {
      "name": "3. Comparar N+1",
      "event": [{"listen": "test", "script": {"exec": [
        "const body = pm.response.json();",
        "pm.test('Eager loading reduce consultas', () => pm.expect(body.after_eager_loading.queries).below(body.before_n_plus_one.queries));"
      ]}}],
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
        "url": "{{baseUrl}}/api/v1/diagnostics/n-plus-one"
      }
    },
    {
      "name": "4. Listar conversaciones",
      "event": [{"listen": "test", "script": {"exec": [
        "const body = pm.response.json();",
        "if (body.length) pm.collectionVariables.set('conversationId', body[0].id);"
      ]}}],
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
        "url": "{{baseUrl}}/api/v1/conversations"
      }
    },
    {
      "name": "5. Detalle cache-aside",
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Encabezado de caché presente', () => pm.expect(['MISS', 'HIT']).to.include(pm.response.headers.get('X-Cache')));"
      ]}}],
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
        "url": "{{baseUrl}}/api/v1/conversations/{{conversationId}}"
      }
    },
    {
      "name": "6. Invalidar caché al crear mensaje",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{accessToken}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {"mode": "raw", "raw": "{\n  \"sender\": \"user\",\n  \"content\": \"Prueba de invalidación explícita\"\n}"},
        "url": "{{baseUrl}}/api/v1/conversations/{{conversationId}}/messages"
      }
    },
    {
      "name": "7. Encolar resumen",
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Trabajo aceptado con 202', () => pm.response.to.have.status(202));",
        "pm.collectionVariables.set('jobId', pm.response.json().id);"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
        "url": "{{baseUrl}}/api/v1/jobs/conversation-summary/{{conversationId}}"
      }
    },
    {
      "name": "8. Consultar trabajo",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
        "url": "{{baseUrl}}/api/v1/jobs/{{jobId}}"
      }
    },
    {
      "name": "9. Renovar token",
      "event": [{"listen": "test", "script": {"exec": [
        "const body = pm.response.json();",
        "pm.collectionVariables.set('accessToken', body.access_token);",
        "pm.collectionVariables.set('refreshToken', body.refresh_token);"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"},
        "url": "{{baseUrl}}/api/v1/auth/refresh"
      }
    },
    {
      "name": "10. Caso token ausente (401)",
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Token ausente devuelve 401', () => pm.response.to.have.status(401));"
      ]}}],
      "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/auth/me"}
    }
  ]
}
